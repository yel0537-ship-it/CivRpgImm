      {
       "text": "Только правителю. Нарушителей — казнить.",
       "next": "end",
       "effects": [
        {
         "taboo": "strict"
        },
        {
         "allLoyalty": -3
        },
        {
         "influence": 5
        }
       ]
      },
      {
       "text": "Правителю — но без казней.",
       "next": "end",
       "effects": [
        {
         "taboo": "lenient"
        }
       ]
