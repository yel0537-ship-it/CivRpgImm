<!-- Сборка Game.Core и EditMode-тестов обычным .NET SDK без Unity: tools/check.sh core-режим -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0649;CS0414;CS0219</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Game/Core/**/*.cs" />
    <Compile Include="../../Assets/Game/Tests/**/*.cs" />
    <Compile Include="Runner.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnitLite" Version="3.14.0" />
  </ItemGroup>
</Project>
